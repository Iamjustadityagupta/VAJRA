# Database
POSTGRES_DB=vajra
POSTGRES_USER=vajra
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://vajra:change-this-password@db:5432/vajra

# Reasoning
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# VAJRA limits
VAJRA_MAX_ATTEMPTS=3
VAJRA_MAX_UPLOAD_MB=25
VAJRA_MAX_ARCHIVE_FILES=500
VAJRA_MAX_CODE_FILES=200
VAJRA_REGRESSION_TIMEOUT=45
VAJRA_SCAN_TIMEOUT=30
VAJRA_FUZZ_SECONDS=2
VAJRA_CORS_ORIGINS=http://localhost:8080,http://localhost

# Frontend. Leave empty for same-origin /api through nginx.
VITE_API_URL=

# Security-tool versions used by Docker builds
SYFT_VERSION=1.33.0
OSV_VERSION=2.2.2
TARGETARCH=amd64
